@startuml

package UserSis{
    class User{
        id : p_key
        name
    }
    class TeamLid{
        team_id: f_key
    }
    class TeamMn{
        team_id: f_key
    }
    class ClubMn{
        club_id: f_key
    }
    class Admin{
        acc_level : max=0 min=inf
    }
}

package ClubSis{
    class Club {
        id : p_key
        name
        disk
    }
    class ClubTeams{
        club_id : f_key
        team_id : f_key
    }
    class Ladder{
        id : p_key
        club_id  : optional

        min_lid_n
        max_lid_n
        challenge rules
        scheduling frequency
        rating parameters
        SportType
    }
}

package TeamSis{
    class Team {
        id : p_key
        SportType
        club_id : optional
        availability for match
    }

    class SportType {
        id : p_key
        name
        min_num_of_pl_in_team
        max_num_of_pl_in_team
    }
    class TeamList{
        team_id : f_id
        lid_id : f_id
    }

    class MatchStatus {
        id : f_id
        name
        desk
    }
    class MatchProposal{
        team1_id : f_id
        team2_id : f_id
        status
    }
    class Match{
        result : optional
        score : optional | recc is Status = End
    }
}







User <|-- TeamLid
User <|-- TeamMn
User <|-- Admin
ClubMn <|-- TeamMn

Team ..> TeamList

TeamList --> TeamLid: show mmbr

TeamMn --> Team : have one
Club --> Team : Owns
Club ..> Team : can owns


Club --> Ladder : Owns
ClubMn --> Club : Owns


Match --> Team : tvt (team v team)
MatchProposal <|-- Match
TeamMn --> MatchProposal: create
TeamMn --> MatchProposal: confirm or decline
TeamMn --> MatchProposal: 2 tems mnd report result



package UserSis{

    note top of TeamLid
        acc by TeamMn
    end note

    note top of TeamMn
        acc by ClubMn || acc by Sis
        mnd one or mm Team-s
    end note

    note top of ClubMn
        acc by Admin
        mnd only one Clube
        act ass TeamMn for all Club Teams
    end note

    note top of Admin
        acc by Sis
        have diff acc level (aka local admin|superadmin|siteowner)
        can have acc to full sis
    end note
}

package ClubSis{
    note top of Club
        type can be rtv by trv all teams type
    end note

}


package TeamSis{
    note top of MatchProposal
        only if 2 teams has same type
    end note

    note top of SportType
        aka enum
    end note

    note top of Team

    end note
}








@enduml